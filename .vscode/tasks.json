{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "OopsNote: Backend Dev Server",
            "type": "shell",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m uvicorn oopsnote.api.main:app --reload --host 127.0.0.1 --port 8000",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONPATH": "${workspaceFolder}"
                }
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "OopsNote: Frontend Dev Server",
            "type": "shell",
            "command": "npm run dev -- -p 3000",
            "options": {
                "cwd": "${workspaceFolder}\\frontend"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "OopsNote: Full Stack Dev Servers",
            "dependsOn": [
                "OopsNote: Backend Dev Server",
                "OopsNote: Frontend Dev Server"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": []
        }
    ]
}
