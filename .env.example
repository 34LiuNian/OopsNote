# OopsNote 生产 Compose 环境变量
# 用法：cp .env.example .env，填写后 docker compose 会自动读取项目目录下的 .env

# 前端对外访问地址（Better Auth 回调与 OIDC redirect 的基础 URL）
OOPSNOTE_PUBLIC_URL=https://oopsnote.example.com

# 认证模式：better-auth | local | oidc（前后端需保持一致）
OOPSNOTE_AUTH_MODE=better-auth
NEXT_PUBLIC_AUTH_MODE=better-auth

# ---- OIDC / Pocket ID（仅 oidc 与 oidc-rollback profile 需要）----
OOPSNOTE_OIDC_AUTHORITY=https://auth.example.com
OOPSNOTE_OIDC_CLIENT_ID=
OOPSNOTE_OIDC_REDIRECT_URI=https://oopsnote.example.com/auth/callback
OOPSNOTE_OIDC_POST_LOGOUT_REDIRECT_URI=https://oopsnote.example.com/
OOPSNOTE_OIDC_SCOPE=openid profile email groups

# 管理员 Pocket ID subject（逗号分隔；配置流程见 deploy/pocket-id/README.md）
OOPSNOTE_ADMIN_SUBJECTS=

# ---- 容器化本地开发（docker-compose.dev.yml）----
# 开发前端对外地址（Better Auth 回调基础 URL；默认 http://localhost:13001）
# OOPSNOTE_DEV_PUBLIC_URL=http://localhost:13001
