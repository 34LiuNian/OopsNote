{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": [
      "node",
      "react",
      "react-dom",
      "@serwist/next/typings"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
      // "@/components/*": ["./components/*"],
      // "@/features/*": ["./features/*"],
      // "@/lib/*": ["./lib/*"],
      // "@/hooks/*": ["./hooks/*"],
      // "@/types/*": ["./types/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-splash-test/types/**/*.ts",
    ".next-splash-test/dev/types/**/*.ts",
    ".next-cold-contract/types/**/*.ts",
    ".next-cold-contract/dev/types/**/*.ts",
    ".next-codex-ai-channels/types/**/*.ts",
    ".next-codex-ai-channels/dev/types/**/*.ts",
    ".next-codex-build-ai-channels/types/**/*.ts",
    ".next-codex-build-ai-channels/dev/types/**/*.ts",
    ".next-codex-build-ai-channels-final/types/**/*.ts",
    ".next-codex-build-ai-channels-final/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "public/sw.js"
  ]
}
