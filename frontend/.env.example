# Copy to .env (same directory as this file)
# Next.js will read .env on startup/build.

# Server-only backend URL used by Next.js rewrites for API + SSE.
OOPSNOTE_BACKEND_URL=http://localhost:8000

# Better Auth is the application-owned identity service. Keep its SQLite file
# on a persistent volume in deployments; do not share it with the Python app.
BETTER_AUTH_URL=http://localhost:3000
OOPSNOTE_AUTH_DB_PATH=./data/auth.sqlite
# Prefer a Docker/1Panel secret file in production. The environment fallback
# is for local development only and must be at least 32 characters.
# OOPSNOTE_BETTER_AUTH_SECRET_FILE=/run/secrets/oopsnote_better_auth_secret
# BETTER_AUTH_SECRET=replace-with-a-long-dev-secret
# First-admin bootstrap is disabled as soon as any Better Auth user exists.
# Prefer a one-time Docker/1Panel secret file in production.
# OOPSNOTE_BOOTSTRAP_SECRET_FILE=/run/secrets/oopsnote_bootstrap_secret
# OOPSNOTE_BOOTSTRAP_SECRET=replace-with-a-different-32-plus-character-secret
# BFF and FastAPI must use the same secret. Prefer a separate secret file.
# OOPSNOTE_BFF_HMAC_SECRET_FILE=/run/secrets/oopsnote_bff_hmac_secret
# OOPSNOTE_BFF_HMAC_SECRET=replace-with-a-different-long-dev-secret

# 默认认证模式：Better Auth（前后端保持一致）
NEXT_PUBLIC_AUTH_MODE=better-auth
# 后端：OOPSNOTE_AUTH_MODE=better-auth（backend 环境）

# 可选：本地开发经反代域名（如 Caddy）访问时，把该域名加入 Next.js 的
# allowedDevOrigins（next.config.mjs 显式读取 .env.local，不写进仓库）。
# OOPSNOTE_DEV_ALLOWED_ORIGIN=https://dev-oopsnote.example.com

# 纯回环本地会话可改用 local 模式（跳过登录，直接本地管理员身份）：
# NEXT_PUBLIC_AUTH_MODE=local
# OOPSNOTE_AUTH_MODE=local（backend 环境）
