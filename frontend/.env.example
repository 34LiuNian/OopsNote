# Copy to .env (same directory as this file)
# Next.js will read .env on startup/build.

# Server-only backend URL used by Next.js rewrites for API + SSE.
OOPSNOTE_BACKEND_URL=http://localhost:8000

# Set both this and OOPSNOTE_AUTH_MODE=local in the backend for local-only use.
# Local mode is intended for loopback development and bypasses Pocket ID.
NEXT_PUBLIC_AUTH_MODE=oidc

# For `npm run dev`, register these localhost callback URLs in Pocket ID first.
# Do not use the production callback URL locally: sessionStorage is origin-scoped.
NEXT_PUBLIC_OIDC_AUTHORITY=https://auth.example.com
NEXT_PUBLIC_OIDC_CLIENT_ID=replace-with-public-client-id
NEXT_PUBLIC_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
NEXT_PUBLIC_OIDC_SCOPE=openid profile email

# For a loopback-only local session, use:
# NEXT_PUBLIC_AUTH_MODE=local
# OOPSNOTE_AUTH_MODE=local (in the backend environment)
