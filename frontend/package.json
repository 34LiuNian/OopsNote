{
  "name": "oopsnote-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -H 0.0.0.0",
    "build": "next build --turbo",
    "start": "next start",
    "lint": "eslint app components features hooks lib types --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "design:check": "node scripts/check-design-system.mjs && node scripts/check-ui-boundaries.mjs",
    "design:migrate:sx": "node scripts/migrate-sx-static.mjs",
    "encoding:check": "node scripts/check-encoding.mjs",
    "errors:check": "node scripts/check-error-notifications.mjs",
    "test:unit": "node --test features/settings/channelDefaults.test.mjs features/settings/modelOptions.test.mjs lib/notificationPolicy.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:credentialed": "playwright test --config playwright.credentialed.config.ts",
    "renderers:sync": "node scripts/sync-renderer-assets.mjs",
    "postinstall": "npm run renderers:sync"
  },
  "dependencies": {
    "@mantine/core": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@mantine/modals": "9.4.1",
    "@mantine/notifications": "9.4.1",
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "@serwist/next": "^9.5.12",
    "@tanstack/react-query": "^5.90.21",
    "better-auth": "1.6.26",
    "better-sqlite3": "13.0.3",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.1",
    "isomorphic-tikzjax": "^0.1.1",
    "katex": "^0.16.22",
    "kysely": "^0.29.4",
    "lucide-react": "^0.468.0",
    "mermaid": "^10.9.3",
    "next": "^16.1.6",
    "pdfjs-dist": "^4.10.38",
    "prop-types": "^15.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-katex": "^3.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.1.6",
    "serwist": "^9.5.12",
    "typescript": "5.6.3"
  }
}
