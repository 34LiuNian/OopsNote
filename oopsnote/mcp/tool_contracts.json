{
  "version": 1,
  "tools": [
    {
      "name": "ocr_image",
      "remoteName": "ocr_image",
      "description": "Extract one OopsNote task image into strict OCR JSON.",
      "parameters": {
        "properties": {
          "task_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "run_id"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "mcp__oopsnote_pipeline_get_task",
      "remoteName": "get_task",
      "description": "Get one managed OopsNote task by id.",
      "parameters": {
        "properties": {
          "task_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "run_id"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "mcp__oopsnote_pipeline_get_asset_path",
      "remoteName": "get_asset_path",
      "description": "Resolve the image asset bound to the active managed run.",
      "parameters": {
        "properties": {
          "task_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "run_id"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "mcp__oopsnote_pipeline_list_tags",
      "remoteName": "list_tags",
      "description": "List tag branches, selected branch leaves, or non-knowledge tag values.",
      "parameters": {
        "properties": {
          "dimension": {
            "enum": [
              "knowledge",
              "error",
              "meta",
              "custom"
            ],
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "subject": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "scope": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "core"
          },
          "branch_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 6,
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "dimension",
          "task_id",
          "run_id"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "mcp__oopsnote_pipeline_create_tag",
      "remoteName": "create_tag",
      "description": "Create or merge one error tag for the active managed run.",
      "parameters": {
        "properties": {
          "dimension": {
            "const": "error",
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "aliases": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "subject": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "dimension",
          "value",
          "task_id",
          "run_id"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "mcp__oopsnote_pipeline_report_task_stage",
      "remoteName": "report_task_stage",
      "description": "Report progress for the active managed OopsNote run.",
      "parameters": {
        "properties": {
          "task_id": {
            "type": "string"
          },
          "stage": {
            "enum": [
              "ocr",
              "solving",
              "verifying",
              "tagging",
              "finalizing"
            ],
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "task_id",
          "stage",
          "run_id"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "mcp__oopsnote_pipeline_finalize_task",
      "remoteName": "finalize_task",
      "description": "Validate and atomically finalize the active OopsNote task.",
      "parameters": {
        "properties": {
          "task_id": {
            "type": "string"
          },
          "problem_json": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "sync_to_obsidian": {
            "default": true,
            "type": "boolean"
          },
          "review_reason": {
            "default": "",
            "enum": [
              "",
              "unreadable",
              "incomplete",
              "multiple_questions",
              "other"
            ],
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "problem_json",
          "run_id"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "mcp__oopsnote_pipeline_fail_task",
      "remoteName": "fail_task",
      "description": "Fail the active OopsNote task with an explicit reason.",
      "parameters": {
        "properties": {
          "task_id": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "review_reason": {
            "default": "",
            "enum": [
              "",
              "unreadable",
              "incomplete",
              "multiple_questions",
              "other"
            ],
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "error",
          "run_id"
        ],
        "type": "object",
        "additionalProperties": false
      }
    }
  ]
}
