{
  "version": 1,
  "tools": [
    {
      "name": "ocr_image",
      "remoteName": "ocr_image",
      "description": "Extract one OopsNote task image into strict OCR JSON.",
      "executionMode": "barrier",
      "parameters": {
        "properties": {
          "task_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "run_id"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "mcp__oopsnote_pipeline_get_task",
      "remoteName": "get_task",
      "description": "Get one managed OopsNote task by id.",
      "executionMode": "parallel",
      "parameters": {
        "properties": {
          "task_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "run_id"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "mcp__oopsnote_pipeline_get_asset_path",
      "remoteName": "get_asset_path",
      "description": "Resolve the image asset bound to the active managed run.",
      "executionMode": "parallel",
      "parameters": {
        "properties": {
          "task_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "run_id"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "mcp__oopsnote_pipeline_list_tags",
      "remoteName": "list_tags",
      "description": "List tag branches, selected branch leaves, or non-knowledge tag values.",
      "executionMode": "barrier",
      "parameters": {
        "properties": {
          "dimension": {
            "enum": [
              "knowledge",
              "error",
              "meta",
              "custom"
            ],
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "subject": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "scope": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "core"
          },
          "branch_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 6,
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "dimension",
          "task_id",
          "run_id"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "mcp__oopsnote_pipeline_create_tag",
      "remoteName": "create_tag",
      "description": "Create or merge one error tag for the active managed run.",
      "executionMode": "barrier",
      "parameters": {
        "properties": {
          "dimension": {
            "const": "error",
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "aliases": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "subject": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "dimension",
          "value",
          "task_id",
          "run_id"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "mcp__oopsnote_pipeline_report_task_stage",
      "remoteName": "report_task_stage",
      "description": "Report progress for the active managed OopsNote run.",
      "executionMode": "barrier",
      "parameters": {
        "properties": {
          "task_id": {
            "type": "string"
          },
          "stage": {
            "enum": [
              "ocr",
              "solving",
              "verifying",
              "tagging",
              "finalizing"
            ],
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "task_id",
          "stage",
          "run_id"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "mcp__oopsnote_pipeline_submit_solution_candidate",
      "remoteName": "submit_solution_candidate",
      "description": "Store one solver candidate for an independent verification session.",
      "executionMode": "barrier",
      "parameters": {
        "properties": {
          "task_id": {
            "type": "string"
          },
          "problem_json": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "review_reason": {
            "default": "",
            "enum": [
              "",
              "unreadable",
              "incomplete",
              "multiple_questions",
              "other"
            ],
            "type": "string"
          },
          "student_response_status": {
            "default": "unknown",
            "enum": [
              "answered",
              "unanswered",
              "unknown"
            ],
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "problem_json",
          "run_id"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "mcp__oopsnote_pipeline_finalize_task",
      "remoteName": "finalize_task",
      "description": "Validate and atomically finalize the active OopsNote task.",
      "executionMode": "barrier",
      "parameters": {
        "properties": {
          "task_id": {
            "type": "string"
          },
          "problem_json": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "sync_to_obsidian": {
            "default": true,
            "type": "boolean"
          },
          "review_reason": {
            "anyOf": [
              {
                "enum": [
                  "",
                  "unreadable",
                  "incomplete",
                  "multiple_questions",
                  "other"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "student_response_status": {
            "anyOf": [
              {
                "enum": [
                  "answered",
                  "unanswered",
                  "unknown"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "task_id",
          "problem_json",
          "run_id"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "mcp__oopsnote_pipeline_fail_task",
      "remoteName": "fail_task",
      "description": "Fail the active OopsNote task with an explicit reason.",
      "executionMode": "barrier",
      "parameters": {
        "properties": {
          "task_id": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "review_reason": {
            "default": "",
            "enum": [
              "",
              "unreadable",
              "incomplete",
              "multiple_questions",
              "other"
            ],
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "error",
          "run_id"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "submit_tikz_revision",
      "remoteName": "submit_tikz_revision",
      "description": "Validate and persist one body-only TikZ revision for the active diagram run.",
      "executionMode": "barrier",
      "parameters": {
        "properties": {
          "task_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "tikz_source": {
            "type": "string"
          },
          "hard_errors": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "soft_differences": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "task_id",
          "run_id",
          "tikz_source"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "accept_tikz_candidate",
      "remoteName": "accept_tikz_candidate",
      "description": "Accept the active rendered TikZ candidate when no hard semantic error remains.",
      "executionMode": "barrier",
      "parameters": {
        "properties": {
          "task_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "soft_differences": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "task_id",
          "run_id"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "keep_source_image",
      "remoteName": "keep_source_image",
      "description": "Keep a normalized crop of the printed source diagram for an automatic diagram run.",
      "executionMode": "barrier",
      "parameters": {
        "$defs": {
          "DiagramSourceRegion": {
            "description": "Normalized source region reserved for a future layout-analysis owner.",
            "properties": {
              "x": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "y": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "width": {
                "exclusiveMinimum": 0,
                "maximum": 1,
                "type": "number"
              },
              "height": {
                "exclusiveMinimum": 0,
                "maximum": 1,
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "type": "object"
          }
        },
        "properties": {
          "task_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "source_region": {
            "$ref": "#/$defs/DiagramSourceRegion"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "run_id",
          "source_region",
          "reason"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "request_diagram_review",
      "remoteName": "request_diagram_review",
      "description": "Finish the active diagram run for human review after its candidate limit is reached.",
      "executionMode": "barrier",
      "parameters": {
        "properties": {
          "task_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "hard_errors": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "task_id",
          "run_id",
          "reason"
        ],
        "type": "object",
        "additionalProperties": false
      }
    }
  ]
}
